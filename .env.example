# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# Kalitlarni hech kimga bermang va git'ga yuklamang.

# --- Asosiy ---
PORT=3000
# production — haqiqiy ishga tushirish (SECRET majburiy, SMS kodlar ekranda ko'rsatilmaydi)
NODE_ENV=development
# Uzun tasodifiy satr (kamida 32 belgi). Chiptalardagi QR imzo shu bilan qilinadi — o'zgartirmang!
SECRET=
# Saytingiz manzili (to'lovdan qaytish, ijtimoiy tarmoq havolalari uchun)
PUBLIC_URL=http://localhost:3000
# Ma'lumotlar bazasi papkasi
DATA_DIR=./data
# Admin telefon raqamlari (vergul bilan), masalan: 998901234567,998935554433
ADMIN_PHONES=

# --- To'lov: demo | click | payme ---
PAYMENT=demo
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=

# --- SMS (Eskiz.uz) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Email (ixtiyoriy webhook: {to, subject, text} JSON yuboriladi) ---
EMAIL_WEBHOOK_URL=

# --- Haqiqiy avia narxlari (Amadeus, ixtiyoriy) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
CURRENCY=USD

# Frontend boshqa manzilda bo'lsa, o'sha manzilni yozing
CORS_ORIGIN=
